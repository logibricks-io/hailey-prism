+namespace {
+
+// Prism (patch 0007): a target is visible to a space-selected session when it
+// is a browser target, is one of the space's tabs, or is a subframe of one.
+bool PrismTargetVisible(content::DevToolsAgentHost* host,
+                        const std::set<std::string>& tab_ids) {
+  if (tab_ids.count(host->GetId())) {
+    return true;
+  }
+  if (host->GetType() == content::DevToolsAgentHost::kTypeBrowser) {
+    return true;
+  }
+  // Subframe targets link to their parent frame target; walk up bounded.
+  std::string hop = host->GetParentId();
+  for (int depth = 0; !hop.empty() && depth < 8; ++depth) {
+    if (tab_ids.count(hop)) {
+      return true;
+    }
+    auto* parent = content::DevToolsAgentHost::GetForId(hop).get();
+    hop = parent ? parent->GetParentId() : std::string();
+  }
+  return false;
+}
