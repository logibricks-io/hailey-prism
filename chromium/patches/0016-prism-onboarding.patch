-      // Prism: onboarding entry — chrome://prism-welcome offers importing
-      // browsing data from the system Chrome/Safari/Firefox (skip is fully
-      // side-effect free). Automation launches always carry a positional URL
-      // or --no-first-run, so this only shows for real user launches.
-      if (base::CommandLine::ForCurrentProcess()->GetArgs().empty()) {
-        browser_creator_->AddFirstRunTabs({GURL("chrome://prism-welcome")});
+      // Prism: onboarding entry — chrome://prism-onboarding runs the 4-step
+      // first-run flow (splash / pitch / import / finish); chrome://prism-welcome
+      // stays reachable directly. Automation launches always carry a
+      // positional URL or --no-first-run, so this only shows for real user
+      // launches, and only until onboarding is completed.
+      if (base::CommandLine::ForCurrentProcess()->GetArgs().empty() &&
+          !prism::OnboardingCompleted()) {
+        browser_creator_->AddFirstRunTabs({GURL("chrome://prism-onboarding")});
       }
     }
   }
