@@ -340,6 +341,10 @@ void LocationBarView::Init() {
   location_icon_view->set_drag_controller(this);
   location_icon_view_ = AddChildView(std::move(location_icon_view));
 
+  // Prism: brand chip at the leading edge (laid out leftmost below).
+  brand_chip_view_ =
+      AddChildView(std::make_unique<prism::PrismBrandChipView>(browser_));
+
   // Initialize the Omnibox view. browser_ can be nullptr on ChromeOS in the
   // case of simple_web_view_dialog. Or it can be nulltpr on ChromeOS and on
   // other desktop platforms in the case of presentation_receiver_window_view.
@@ -912,6 +917,19 @@ void LocationBarView::Layout(PassKey) {
       LayoutConstant::kLocationBarTrailingDecorationEdgePadding);
 
   const int location_height = std::max(height() - (vertical_padding * 2), 0);
+
+  // Prism: the brand chip is always the leftmost decoration. The layout
+  // stretches decorations to the full location height; pin the chip to ego's
+  // measured 22 DIP instead, vertically centered.
+  if (brand_chip_view_) {
+    constexpr int kBrandChipHeight = 22;
+    const int chip_offset =
+        std::max((location_height - kBrandChipHeight) / 2, 0);
+    leading_decorations.AddDecoration(
+        vertical_padding + chip_offset,
+        std::min(location_height, kBrandChipHeight), false, 0,
+        /*intra_item_padding=*/6, icon_left, brand_chip_view_);
+  }
   // The largest fraction of the omnibox that can be taken by the EV or search
   // label/chip.
   const double kLeadingDecorationMaxFraction = 0.5;
