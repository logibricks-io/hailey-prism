+  // Prism: spaces dashboard trigger pinned to the top-right corner of the
+  // tab strip row (recon §7); click runs the same action as ⌥S.
+  if (browser &&
+      (browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL)) {
+    prism_spaces_button_ = AddChildView(
+        std::make_unique<prism::PrismSpacesButton>(browser));
+    prism_spaces_button_->SetProperty(views::kCrossAxisAlignmentKey,
