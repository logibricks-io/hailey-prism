+void BrowserView::SetSpacesModeActive(bool active,
+                                     std::optional<int> open_space_id) {
+  if (active == spaces_mode_active_ ||
+      browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return;
+  }
+  spaces_mode_active_ = active;
+  if (active) {
+    // recon §8 choreography: the wall (backdrop fade + overlay preload)
+    // covers the client area immediately; the chrome collapse lands ~200ms
+    // in, masked by the backdrop — no jump cut. The mode-bar caption lands
+    // ~150ms after the collapse (the shrink's second half).
+    spaces_mode_host_->ShowSpacesWall();
+    PreferredSizeChanged();
+    spaces_mode_collapse_timer_.Start(
+        FROM_HERE, base::Milliseconds(200),
+        base::BindOnce(&BrowserView::CollapseChromeForSpacesMode,
+                       weak_ptr_factory_.GetWeakPtr()));
+    return;
+  }
+  spaces_mode_collapse_timer_.Stop();
+  if (spaces_mode_chrome_collapsed_) {
+    RestoreChromeFromSpacesMode();
+  }
+  spaces_mode_host_->HideSpacesWall();
+  PreferredSizeChanged();
+  if (open_space_id.has_value()) {
+    // Same completion as the wall's own exit action: focus + show.
+    prism::SpaceManager* manager = prism::SpaceManager::GetInstance();
+    manager->set_focused_space_id(*open_space_id);
+    prism::GetPrismSpaceWindowDelegate()->ShowTaskSpace(*open_space_id, {});
+    manager->SetWindowShown(*open_space_id, true);
+  }
+}
+
+void BrowserView::CollapseChromeForSpacesMode() {
+  spaces_mode_chrome_collapsed_ = true;
+  // Collapse the normal chrome: toolbar, bookmark bar, infobars; the tab
+  // strip row reduces to the spaces caption + corner trigger.
+  // TopContainerView's children hide individually — some toolbar children
+  // (e.g. the Reload menu button) otherwise linger in the macOS
+  // accessibility tree.
+  for (views::View* child : top_container_->children()) {
+    spaces_mode_contents_visibility_[child] = child->GetVisible();
+    child->SetVisible(false);
+  }
+  toolbar_->SetVisible(false);
+  // The Reload menu button's menu-model adapter keeps an AXPopUpButton in
+  // the macOS accessibility tree even when the toolbar hides — hide it
+  // explicitly for the mode's duration.
+  if (ReloadButton* reload = toolbar_->reload_button()) {
+    reload->SetVisible(false);
+  }
+  if (bookmark_bar_view_) {
+    bookmark_bar_was_visible_ = bookmark_bar_view_->GetVisible();
+    bookmark_bar_view_->SetVisible(false);
+  }
+  infobar_container_->SetVisible(false);
+  // The wall covers the client area; also pull the tab contents out of the
+  // accessibility tree/hit-testing for the mode's duration (recon §8: ego's
+  // dashboard exposes no page content). The container itself must stay
+  // visible (BrowserViewTabbedLayoutImpl CHECKs it), so hide its children.
+  for (views::View* child : contents_container_->children()) {
+    spaces_mode_contents_visibility_[child] = child->GetVisible();
+    child->SetVisible(false);
+  }
+  horizontal_tab_strip_region_view_->SetSpacesMode(true);
+  PreferredSizeChanged();
+}
+
+void BrowserView::RestoreChromeFromSpacesMode() {
+  spaces_mode_chrome_collapsed_ = false;
+  for (auto& [view, was_visible] : spaces_mode_contents_visibility_) {
+    view->SetVisible(was_visible);
+  }
+  spaces_mode_contents_visibility_.clear();
+  toolbar_->SetVisible(true);
+  if (ReloadButton* reload = toolbar_->reload_button()) {
+    reload->SetVisible(true);
+  }
+  if (bookmark_bar_view_) {
+    bookmark_bar_view_->SetVisible(bookmark_bar_was_visible_);
+  }
+  infobar_container_->SetVisible(true);
+  horizontal_tab_strip_region_view_->SetSpacesMode(false);
+}
+
+void BrowserView::LayoutSpacesModeHost() {
+  if (!spaces_mode_host_ || !spaces_mode_host_->GetVisible()) {
+    return;
+  }
+  // The wall fills the client area edge to edge. Track the contents top
+  // (below the toolbar until the choreographed collapse runs, below the
+  // tab-strip row after).
+  const int top = contents_container_ ? contents_container_->bounds().y()
+                                      : 0;
+  spaces_mode_host_->SetBounds(0, top, width(), height() - top);
+}
