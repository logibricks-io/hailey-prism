+void HorizontalTabStripRegionView::SetSpacesMode(bool active) {
+  if (spaces_mode_ == active) {
+    return;
+  }
+  spaces_mode_ = active;
+  if (active) {
+    spaces_mode_saved_visibility_.clear();
+    auto stash = [this](views::View* view) {
+      if (view) {
+        spaces_mode_saved_visibility_.emplace_back(view, view->GetVisible());
+        view->SetVisible(false);
+      }
+    };
+    stash(tab_strip_);
+    stash(combo_button_);
+    stash(unfocus_button_);
+    stash(new_tab_button_);
+    stash(tab_strip_action_container_);
+    stash(reserved_grab_handle_space_);
+  } else {
+    for (const auto& [view, was_visible] : spaces_mode_saved_visibility_) {
+      view->SetVisible(was_visible);
+    }
+    spaces_mode_saved_visibility_.clear();
+    if (tab_strip_) {
+      tab_strip_->SetVisible(true);
+    }
+  }
+  if (prism_spaces_caption_) {
+    spaces_caption_timer_.Stop();
+    prism_spaces_caption_->SetVisible(false);
+    if (active) {
+      // recon §8: the caption lands in the shrink's second half, ~150ms
+      // after the chrome collapse — not as a jump cut.
+      spaces_caption_timer_.Start(
+          FROM_HERE, base::Milliseconds(150),
+          base::BindOnce(&HorizontalTabStripRegionView::ShowSpacesCaption,
+                         base::Unretained(this)));
+    }
+  }
+  PreferredSizeChanged();
+}
+
+void HorizontalTabStripRegionView::ShowSpacesCaption() {
+  if (spaces_mode_ && prism_spaces_caption_) {
+    prism_spaces_caption_->SetVisible(true);
+  }
+}
