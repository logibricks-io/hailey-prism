import("//build/config/compiler/compiler.gni")
import("//build/config/chrome_build.gni")
import("//build/util/process_version.gni")
import("//testing/test.gni")

# Brand + version constants (PRISM_PRODUCT_NAME, PRISM_PRODUCT_VERSION),
# generated from the pinned //chrome/VERSION and the active BRANDING file so
# the kernel domain never drifts from the shipped build.
process_version("generate_version") {
  process_only = true
  template_file = "version/prism_version_values.h.version"
  sources = [
    "//chrome/VERSION",
    branding_file_path,
  ]
  output = "$target_gen_dir/version/prism_version_values.h"
}

source_set("prism") {
  sources = [
    "browser/snapshot/snapshot_composer.cc",
    "browser/snapshot/snapshot_composer.h",
    "browser/spaces/space_manager.cc",
    "browser/spaces/space_manager.h",
    "browser/spaces/space_window_delegate.cc",
    "browser/spaces/space_window_delegate.h",
  ]

  deps = [
    ":generate_version",
    "//base",
  ]

  # DevTools handler + snapshot job land in content/browser (patch series —
  # they need content/ internals); this target stays pure logic:
  #   browser/devtools/prism_domain_handler.{h,cc}
  #   browser/snapshot/snapshot_job.{h,cc}
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "browser/snapshot/snapshot_composer_unittest.cc",
    "browser/spaces/space_manager_unittest.cc",
  ]
  deps = [
    ":prism",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

# Executable test binary for the pure-logic unit tests (source_set above only
# compiles them).
test("prism_unit_tests") {
  sources = [
    "browser/snapshot/snapshot_composer_unittest.cc",
    "browser/spaces/space_manager_unittest.cc",
  ]
  deps = [
    ":prism",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
