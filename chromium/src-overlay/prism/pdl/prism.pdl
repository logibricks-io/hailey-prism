# Prism DevTools domain definition (PDL)
#
# This is the kernel-side contract surface of Prism: the harness's prism.*
# bindings forward to these commands (docs/binding-contract.md). Registered as
# a custom domain via the patch series (chromium/patches/).
#
# Error convention: failures use the standard CDP error channel; the message
# carries the stable code prefix, e.g. "PRISM_TASK_SPACE_NOT_FOUND: ...".
# Codes are the contract; wording may drift (binding-contract.md §3).

version
  major 1
  minor 0

experimental domain Prism

  # A task space: an isolated browsing context owned by an agent or the user.
  type TaskSpace extends object
    properties
      integer id
      string taskId
      string name
      # "agent" | "user"
      string createdBy
      # "agent" | "user" | "agentDelegatedToUser"
      string ownership
      optional array of string recentTabTitles
      # Agent-visible status label (Phase 4); empty when unset.
      optional string agentTaskState
      # Whether a visible browser window currently hosts the space's tabs.
      optional boolean windowShown

  type TabInfo extends object
    properties
      string targetId
      string title
      string url
      boolean active
      optional integer index

  type SnapshotRef extends object
    properties
      integer backendNodeId
      string role
      string name

  # ---- task space lifecycle ----

  command listTaskSpaces
    returns
      array of TaskSpace taskSpaces

  command createTaskSpace
    parameters
      string name
    returns
      TaskSpace taskSpace

  # Selects the space this DevTools session operates on. Per-session state:
  # listTabs/snapshot/raw-CDP target filtering apply to the selected space.
  command useTaskSpace
    parameters
      integer id
    returns
      TaskSpace taskSpace

  command claimTaskSpace
    parameters
      integer id
      optional string name
    returns
      TaskSpace taskSpace

  command completeTaskSpace
    returns
      boolean done

  command closeTaskSpace
    returns
      boolean done

  command handOffTaskSpace
    returns
      TaskSpace taskSpace

  command takeOverTaskSpace
    returns
      TaskSpace taskSpace

  # ---- tabs ----

  command listTabs
    returns
      array of TabInfo tabs

  command createTab
    parameters
      string url
    returns
      string targetId

  # ---- Phase 4: space windows + agent state ----

  # Opens (or focuses) a visible browser window hosting the space's current
  # tabs; the windowless WebContents move into it. Calling again after more
  # createTab calls pulls the new tabs into the same window. Window/UX action,
  # not page-driving: stays allowed while the space is handed off (the user is
  # exactly who needs to look).
  command showTaskSpace
    parameters
      integer id
    returns
      boolean done

  # Sets the agent's status label for the selected space; shown in the space
  # window and on chrome://prism-spaces. Display-only: allowed while handed
  # off (lets the agent say "waiting for you").
  command setAgentTaskState
    parameters
      string label
    returns
      boolean done

  # Brief click-highlight marker at page coordinates (x, y) of the selected
  # space's window; no-op while the space is not shown. Driving-adjacent:
  # rejected while the space is user-controlled.
  command animationHighlightMouseToPosition
    parameters
      integer x
      integer y
    returns
      boolean done

  # ---- snapshot (Phase 3 kernel renderer) ----

  command snapshot
    parameters
      # "only_within_viewport" | "full_page" (harness forces full_page)
      optional string scope
      optional boolean includeActionMarks
      optional boolean includeStableLocator
      optional integer maxResultLength
    returns
      string content
      array of SnapshotRef refs

  # ---- version ----

  command getBrowserVersion
    returns
      string currentVersion
      boolean updateAvailable
      optional string latestVersion
      optional boolean mandatory
